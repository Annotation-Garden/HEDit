# ============================================================================
# HEDit Environment Configuration
# ============================================================================
# IMPORTANT: Do NOT use inline comments! Comments must be on their own line.
# WRONG:  API_KEYS=mykey  # this is my key
# RIGHT:  # This is my key
#         API_KEYS=mykey

# ============================================================================
# Security Configuration (REQUIRED for production)
# ============================================================================

# API Key Authentication
# Generate keys using: python scripts/generate_api_key.py
# Supports multiple keys (comma-separated)
API_KEYS=your-generated-api-key-here

# Set to "false" only for local development without auth
REQUIRE_API_AUTH=true

# BYOK (Bring Your Own Key) Mode
# When enabled, users can provide their own Anthropic API key (sk-ant-...)
# via the X-Anthropic-Key header. Their key is used for LLM calls against
# the first-party Anthropic API (billing goes to their account).
# Set to "false" to require server API keys only
ALLOW_BYOK=true

# Audit Logging (recommended for production)
ENABLE_AUDIT_LOG=true
AUDIT_LOG_FILE=/var/log/hedit/audit.log

# CORS Configuration
# Production frontend (hedit.pages.dev) is always allowed
# Localhost origins are allowed by default for testing
ALLOW_LOCALHOST_CORS=true

# Add extra origins here (comma-separated) if needed
# EXTRA_CORS_ORIGINS=https://example.com,https://other.com

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Temperature: 0.0-1.0, lower = more consistent
LLM_TEMPERATURE=0.1

# ============================================================================
# Anthropic Configuration (Claude Platform on AWS)
# ============================================================================
# LLM calls go to Claude via the Claude Platform on AWS (Anthropic-operated
# Messages API, AWS Marketplace billing; NOT Amazon Bedrock).
# All three values are required in server mode; the endpoint rejects
# requests without the anthropic-workspace-id header.
# Key: AWS Console -> Claude Platform on AWS -> API keys -> Generate a key
# Workspace: AWS Console -> Claude Platform on AWS -> Workspaces (wrkspc_...)
ANTHROPIC_API_KEY=your-claude-platform-key-here
ANTHROPIC_BASE_URL=https://aws-external-anthropic.us-east-2.api.aws
ANTHROPIC_WORKSPACE_ID=wrkspc_your_workspace_id

# ============================================================================
# Model Configuration
# ============================================================================
# Offered models: claude-haiku-4-5 (default) and claude-sonnet-5.

# Annotation Model (Claude Haiku 4.5 - fast, near-frontier quality)
ANNOTATION_MODEL=claude-haiku-4-5

# Evaluation/Assessment Model (the judge stays on Haiku)
EVALUATION_MODEL=claude-haiku-4-5

# Vision Model (Claude models are natively multimodal)
VISION_MODEL=claude-haiku-4-5

# For highest annotation quality (slower, more expensive):
# ANNOTATION_MODEL=claude-sonnet-5

# ============================================================================
# Prompt Cache Lifetime
# ============================================================================
# The annotation system prompt (~21.8k tokens of HED vocabulary guide) is
# cached, which cuts input cost by ~90% on a cache hit. Entries live 5
# minutes by default, which suits server traffic; a cache write costs 1.25x,
# so break-even is the second request inside the window.
# Set to 1h for interactive use where requests are minutes apart (a 1-hour
# write costs 2x and pays off from the third request in the hour).
# See docs/prompt-caching.md
# HEDIT_PROMPT_CACHE_TTL=5m

# ============================================================================
# HED Configuration
# ============================================================================
HED_SCHEMA_VERSION=8.4.0

# ============================================================================
# HED-LSP Configuration (Recommended)
# ============================================================================
# HEDit holds one persistent connection to the hed-lsp Node server for the
# lifetime of the process (server mode) or the command (standalone CLI).
# Install hed-lsp: git clone https://github.com/hed-standard/hed-lsp.git
#                  cd hed-lsp/server && npm install && npm run compile
#
# Path to the built server.js. Inside the official Docker image this is
# baked in at /app/hed-lsp/server/out/server.js. Outside Docker, point it
# at your local checkout.
# HED_LSP_SERVER_JS=/path/to/hed-lsp/server/out/server.js

# Set to 1 to disable the persistent LSP connection entirely (the workflow
# will run with keyword-only preprocessing, no LSP tag enrichment).
# HED_LSP_DISABLE=0

# Override the per-user runtime directory used by `hedit lsp start` to
# place its socket and PID file.
# HEDIT_LSP_RUNTIME_DIR=/path/to/runtime/dir

# Set HEDIT_LSP=0 to make `hedit annotate` ignore an already-running
# daemon (useful when debugging without the LSP path).
# HEDIT_LSP=1

# ============================================================================
# Legacy JavaScript Validator (Deprecated)
# ============================================================================
# NOTE: The JavaScript validator is deprecated in favor of hed-lsp.
# Only use if you need the legacy hed-javascript integration.
#
# NOTE: In Docker, paths are auto-detected. Do NOT set these unless you
# need to override (e.g., for local development outside Docker).
# Setting empty values will BREAK Docker deployment!

# Only uncomment if running locally outside Docker:
# HED_SCHEMA_DIR=/path/to/hed-schemas/schemas_latest_json
# HED_VALIDATOR_PATH=/path/to/hed-javascript

USE_JS_VALIDATOR=false

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=38427
API_WORKERS=4

# ============================================================================
# Workflow Configuration
# ============================================================================
MAX_VALIDATION_ATTEMPTS=3
MAX_TOTAL_ITERATIONS=4

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Feedback Processing (Optional)
# ============================================================================
# GitHub token for automatic issue creation from user feedback
# Required scopes: repo (for creating issues and comments)
# Get a token from: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your-github-token-here

# Repository for feedback issues (defaults to Annotation-Garden/hedit)
# GITHUB_REPOSITORY_OWNER=Annotation-Garden
# GITHUB_REPOSITORY=hedit

# Feedback processing uses the ANTHROPIC_API_KEY server credentials.
